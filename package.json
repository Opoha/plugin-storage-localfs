{
  "name": "@opoha/plugin-storage-localfs",
  "version": "0.1.0",
  "description": "Official Opoha local filesystem storage adapter plugin (MVP E-03)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "opoha.plugin.json"
  ],
  "opoha": {
    "id": "storage-localfs",
    "version": "0.1.0",
    "contractVersion": "0.1",
    "entry": "dist/index.js",
    "displayName": "Local Filesystem Storage",
    "description": "Registers a local disk storage adapter for the files abstraction",
    "dependsOn": [],
    "required": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opoha/plugin-sdk": "file:../opoha-plugin-sdk"
  },
  "devDependencies": {
    "@opoha/typescript-config": "file:../opoha-devkit/packages/typescript-config",
    "@opoha/vitest-config": "file:../opoha-devkit/packages/vitest-config",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@11.7.0"
}
